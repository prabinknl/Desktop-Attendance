# ====================================================
# Hikvision Local Gateway & Attendance Agent Config
# ====================================================

# Local LAN Physical Hikvision Machine Credentials
HIKVISION_IP=192.168.0.6
HIKVISION_PORT=80
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=your_device_web_password

# Backend API Configuration (use your deployed attendance API + /api)
# For local development, override this with http://localhost:3001/api.
SERVER_URL=https://desktop-attendance.appnep.com/api
# Prefer CONNECTOR_TOKEN from Device Settings → Generate connector token
CONNECTOR_TOKEN=
# Legacy shared secret (optional if CONNECTOR_TOKEN is set on server)
GATEWAY_SECRET=attendence_local_gateway_secret_2026

# Polling & Sync Timers (in seconds)
SYNC_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=30
