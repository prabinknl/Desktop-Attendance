{
  "name": "attendence",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002 --open",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json && node -e \"require('fs').cpSync('server/src/db/migrations','server/dist/db/migrations',{recursive:true})\"",
    "build:electron-ui": "vite build --config vite.config.electron.ts",
    "build:icon": "node electron/scripts/generate-icon.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:invitations": "vitest run server/src/services/auth/invitationService.test.ts src/lib/inviteToken.test.ts",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n server,vite,electron -c blue,green,magenta \"npm run dev:server\" \"npm run dev\" \"wait-on http://127.0.0.1:3002 http://127.0.0.1:3001/api/health && electron .\"",
    "electron:pack": "npm run build:server && npm run build:electron-ui && node electron/scripts/prepare-server-resources.mjs && node electron/scripts/build-win.mjs --dir",
    "electron:build": "npm run build:server && npm run build:electron-ui && node electron/scripts/prepare-server-resources.mjs && node electron/scripts/build-win.mjs",
    "dist": "npm run build:icon && npm run electron:build",
    "dist:dir": "npm run electron:pack"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@hookform/resolvers": "^5.4.0",
    "@insforge/sdk": "^1.5.2",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^6.5.1",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "nepali-date-converter": "^3.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "uuid": "^14.0.1",
    "vite": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  },
  "description": "Attendance management app (web + Windows desktop via Electron).",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.attendance.desktop",
    "productName": "Attendance Desktop",
    "copyright": "Copyright © Attendance Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron-resources/server",
        "to": "server",
        "filter": [
          "dist/**/*",
          "package.json",
          ".env.example",
          "!.env",
          "!**/.env"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "prabinknl",
        "repo": "Desktop-Attendance"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Attendance.Desktop.Setup.${version}.${ext}",
      "executableName": "Attendance Desktop"
    },
    "nsis": {
      "guid": "com.attendance.desktop",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Attendance Desktop",
      "uninstallDisplayName": "Attendance Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "afterPack": "electron/scripts/after-pack.cjs"
  }
}
