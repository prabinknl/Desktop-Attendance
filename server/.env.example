# Attendance Desktop API — Hostinger MySQL (preferred) + legacy Postgres/InsForge fallback
#
# Frontend hosted API base (Vite): https://desktop-attendance.appnep.com/api
# Set VITE_API_BASE_URL=https://desktop-attendance.appnep.com/api for production web builds.

# --- MySQL / MariaDB (Hostinger) ---
DB_HOST=your-mysql-host.hostinger.com
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Optional override: mysql | postgres (auto-detected from DB_* / DATABASE_URL when unset)
DB_DRIVER=mysql

# Optional future JWT hardening (not required for current session auth)
JWT_SECRET=

# --- Legacy Postgres / InsForge fallback ---
# DATABASE_URL=postgresql://user:pass@host:5432/attendance_db
# INSFORGE_BASE_URL=https://your-app.region.insforge.app
# INSFORGE_API_KEY=

# Server
PORT=3002
HOST=0.0.0.0
NODE_ENV=development
ENCRYPTION_KEY=
DEVICE_SYNC_ENABLED=true
APP_PUBLIC_URL=http://127.0.0.1:3000
ADMIN_SIGNUP_EMAIL=
# Optional: secret required to register the first Owner (route closes once an Owner exists)
# OWNER_SETUP_CODE=

# SMTP (invitation / OTP emails via Hostinger API)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS (comma-separated origins; defaults include desktop-attendance.appnep.com)
# CORS_ORIGINS=
