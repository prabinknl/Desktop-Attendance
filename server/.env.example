# Copy this file to server/.env for local development.
# On Hostinger, set the same names in hPanel → Node.js → Environment variables.
# Do not commit real passwords, tokens, or API keys.

# Server
# Local fallback is 3002 (Vite proxies /api there). Hostinger injects PORT — do not hardcode it in production.
PORT=3002
NODE_ENV=development
# HOST=0.0.0.0
# CORS_ORIGINS=https://desktop-attendance.appnep.com,https://attendance.appnep.com

# PostgreSQL (InsForge database)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_PROJECT.ap-southeast.database.insforge.app:5432/insforge?sslmode=require

# AES-256 encryption key for device passwords (32-byte hex string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mock / simulated device responses are permanently disabled.
# Real Hikvision ISAPI Digest authentication is always used.
DEVICE_MOCK_MODE=false

# Only this email may register as admin
ADMIN_SIGNUP_EMAIL=appnep@pacenp.com

# Public origin used in invitation emails
# Development mode defaults to http://127.0.0.1:3002 if APP_PUBLIC_URL is omitted.
# In production (NODE_ENV=production), APP_PUBLIC_URL must be your HTTPS domain.
APP_PUBLIC_URL=https://desktop-attendance.appnep.com

# SMTP for invitation and verification emails (required to deliver email)
# Hostinger mail example (port 465, implicit TLS):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Gmail example (port 587, STARTTLS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_from_address

# InsForge BaaS Backend Integration (database / auth / storage — server-side only)
INSFORGE_BASE_URL=https://your-project.ap-southeast.insforge.app
INSFORGE_API_KEY=your_insforge_api_key

# --- SMS Verification Service ---
# Set SMS_PROVIDER=twilio for Twilio or SMS_PROVIDER=http_gateway for regional REST SMS (Sparrow SMS, Aakash SMS, etc.)
# Set SMS_DEV_MODE=true ONLY in non-production local environments to enable console mock mode.
SMS_PROVIDER=twilio
SMS_DEV_MODE=false

# Twilio SMS Provider Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+18005550199

# Regional REST HTTP Gateway Alternative (e.g. Sparrow SMS / Aakash SMS in Nepal)
SMS_API_URL=https://api.sparrowsms.com/v2/sms/
SMS_API_KEY=
SMS_SENDER_ID=PACE


# --- Windows desktop (Electron) ---
# The installer does NOT bundle server/.env. On first launch the app creates:
#   %APPDATA%\attendence\server.env
# To share the same DB/password key as local `npm run dev:all`, copy this
# file (or your real server/.env) to that path, then restart Attendance.exe.
# DEVICE_SYNC_ENABLED=true keeps Hikvision ISAPI enabled on the office LAN.
# Hostinger production should set DEVICE_SYNC_ENABLED=false (LAN machine is not reachable).
DEVICE_SYNC_ENABLED=true
