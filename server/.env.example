# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance_db

# AES-256 encryption key for device passwords (32-byte hex string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mock / simulated device responses are permanently disabled.
# Real Hikvision ISAPI Digest authentication is always used.
DEVICE_MOCK_MODE=false

# Only this email may register as admin
ADMIN_SIGNUP_EMAIL=appnep@pacenp.com

# SMTP for admin signup verification codes (required to deliver email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=