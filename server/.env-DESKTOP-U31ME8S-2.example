# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance_db

# AES-256 encryption key for device passwords (32-byte hex string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mock / simulated device responses are permanently disabled.
# Real Hikvision ISAPI Digest authentication is always used.
DEVICE_MOCK_MODE=false

# Canonical admin email — only this address may register as admin
ADMIN_EMAIL=appnep@pacenp.com
# Legacy alias (backward compat) – set both to the same value
ADMIN_SIGNUP_EMAIL=appnep@pacenp.com

# SMTP for admin signup verification codes (required to deliver email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# InsForge BaaS Backend Integration
INSFORGE_BASE_URL=
INSFORGE_API_KEY=


# --- Windows desktop (Electron) ---
# The installer does NOT bundle server/.env. On first launch the app creates:
#   %APPDATA%\attendence\server.env
# To share the same DB/password key as local `npm run dev:all`, copy this
# file (or your real server/.env) to that path, then restart Attendance.exe.
# DEVICE_SYNC_ENABLED=true keeps Hikvision ISAPI enabled on the office LAN.
DEVICE_SYNC_ENABLED=true
